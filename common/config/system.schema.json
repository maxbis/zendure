{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zendure.local/schemas/system.schema.json",
  "title": "Zendure shared system configuration",
  "description": "Canonical non-secret battery, forecast, schedule, installation and price-conversion values shared across the Zendure project.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "battery",
    "forecast",
    "schedule",
    "installation",
    "priceConversion"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Contract version understood by configuration loaders.",
      "const": 1
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacityWh",
        "minChargePercent",
        "maxChargePercent",
        "efficiency",
        "maxChargePowerW",
        "maxDischargePowerW"
      ],
      "properties": {
        "capacityWh": {
          "description": "Nominal total battery capacity in watt-hours.",
          "type": "integer",
          "minimum": 1
        },
        "minChargePercent": {
          "description": "Persistent lower state-of-charge boundary as a whole percentage.",
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "maxChargePercent": {
          "description": "Persistent upper state-of-charge boundary as a whole percentage.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "efficiency": {
          "description": "One-way charge and discharge efficiency factor used by battery forecasts.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "maxChargePowerW": {
          "description": "Maximum charge command magnitude in watts.",
          "type": "integer",
          "minimum": 1
        },
        "maxDischargePowerW": {
          "description": "Maximum discharge command magnitude in watts.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultHouseholdUsageWByHour"
      ],
      "properties": {
        "defaultHouseholdUsageWByHour": {
          "description": "Fallback household demand for each local hour from 00 through 23, in watts.",
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minPowerW",
        "maxPowerW",
        "powerStepW"
      ],
      "properties": {
        "minPowerW": {
          "description": "Lowest signed power accepted by schedule planning and editing.",
          "type": "integer",
          "maximum": 0
        },
        "maxPowerW": {
          "description": "Highest signed power accepted by schedule planning and editing.",
          "type": "integer",
          "minimum": 0
        },
        "powerStepW": {
          "description": "Power increment used by schedule planning and editing.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "latitude",
        "longitude",
        "timezone"
      ],
      "properties": {
        "name": {
          "description": "Human-readable installation location.",
          "type": "string",
          "minLength": 1
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timezone": {
          "description": "IANA timezone used for local schedules and solar calculations.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "priceConversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplierMarkupEurPerKwh",
        "energyTaxEurPerKwh",
        "vatMultiplier",
        "consumerPrecision",
        "spotPrecision"
      ],
      "properties": {
        "supplierMarkupEurPerKwh": {
          "type": "number",
          "minimum": 0
        },
        "energyTaxEurPerKwh": {
          "type": "number",
          "minimum": 0
        },
        "vatMultiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "consumerPrecision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "spotPrecision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      }
    }
  }
}
