{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zendure.local/schemas/system.schema.json",
  "title": "Zendure shared system configuration",
  "description": "Canonical non-secret battery, forecast, schedule, installation and price-conversion values shared across the Zendure project.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "battery",
    "forecast",
    "schedule",
    "installation",
    "priceConversion"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Contract version understood by configuration loaders.",
      "const": 1
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacityWh",
        "minChargePercent",
        "maxChargePercent",
        "efficiency",
        "maxChargePowerW",
        "maxDischargePowerW"
      ],
      "properties": {
        "capacityWh": {
          "description": "Nominal total battery capacity in watt-hours.",
          "type": "integer",
          "minimum": 1
        },
        "minChargePercent": {
          "description": "Persistent lower state-of-charge boundary as a whole percentage.",
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "maxChargePercent": {
          "description": "Persistent upper state-of-charge boundary as a whole percentage.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "efficiency": {
          "description": "One-way charge and discharge efficiency factor used by battery forecasts.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "roundTripEfficiency": {
          "description": "Optional round-trip efficiency factor used by the rolling optimizer.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "wearCostEurPerKwhDischarged": {
          "description": "Battery wear cost in euros per AC-side kilowatt-hour discharged, used only by the rolling optimizer objective.",
          "type": "number",
          "minimum": 0
        },
        "maxChargePowerW": {
          "description": "Maximum charge command magnitude in watts.",
          "type": "integer",
          "minimum": 1
        },
        "maxDischargePowerW": {
          "description": "Maximum discharge command magnitude in watts.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultHouseholdUsageWByHour"
      ],
      "properties": {
        "defaultHouseholdUsageWByHour": {
          "description": "Fallback household demand keyed by each local whole-hour start from 00:00 through 23:00, in watts.",
          "type": "object",
          "minProperties": 24,
          "maxProperties": 24,
          "propertyNames": {
            "enum": [
              "00:00", "01:00", "02:00", "03:00", "04:00", "05:00",
              "06:00", "07:00", "08:00", "09:00", "10:00", "11:00",
              "12:00", "13:00", "14:00", "15:00", "16:00", "17:00",
              "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minPowerW",
        "maxPowerW",
        "powerStepW"
      ],
      "properties": {
        "minPowerW": {
          "description": "Lowest signed power accepted by schedule planning and editing.",
          "type": "integer",
          "maximum": 0
        },
        "maxPowerW": {
          "description": "Highest signed power accepted by schedule planning and editing.",
          "type": "integer",
          "minimum": 0
        },
        "powerStepW": {
          "description": "Power increment used by schedule planning and editing.",
          "type": "integer",
          "minimum": 1
        },
        "activeHourDeadbandW": {
          "description": "Minimum modeled power difference required to replace the already-active optimizer command; zero disables stabilization.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "latitude",
        "longitude",
        "timezone"
      ],
      "properties": {
        "name": {
          "description": "Human-readable installation location.",
          "type": "string",
          "minLength": 1
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timezone": {
          "description": "IANA timezone used for local schedules and solar calculations.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "priceConversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplierMarkupEurPerKwh",
        "energyTaxEurPerKwh",
        "vatMultiplier",
        "consumerPrecision",
        "spotPrecision"
      ],
      "properties": {
        "supplierMarkupEurPerKwh": {
          "type": "number",
          "minimum": 0
        },
        "energyTaxEurPerKwh": {
          "type": "number",
          "minimum": 0
        },
        "vatMultiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "consumerPrecision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "spotPrecision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      }
    }
  }
}
