# Copy to .env and adjust. Used by api/report_data.php before running the report generator.

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=sqlite_replication

# Optional: absolute path for cached report JSON (default: daily_report/data). Use when PHP cannot mkdir under the app tree.
# DAILY_REPORT_DATA_DIR=/var/lib/zendure/daily_report_data

# Interpreter for daily_report/tools/hourly_daily_grid_battery_report.py (default: python3).
# Use a full path if the web user PATH lacks python3, e.g. PYTHON_BIN=/usr/bin/python3
# PYTHON_BIN=/usr/bin/python3
